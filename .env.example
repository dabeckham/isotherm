# Copy to .env and adjust per host. .env is git-ignored.

# Identity of THIS receiver. Each property/receiver gets a unique id so every
# reading is attributable to where it was heard (design is multi-receiver).
STATION_ID=sl-main

# Collection timezone (IANA name). Offsets are derived DST-aware per reading.
TZ_NAME=America/Chicago

# SDR frequency. 433.92M covers Acurite and most consumer 433 MHz sensors.
RTL_FREQ=433.92M

# TimescaleDB credentials (local to this stack).
PGUSER=isotherm
PGPASSWORD=change-me
PGDATABASE=isotherm

# Optional host-exposed ports (uncomment the matching lines in compose too).
MQTT_WS_PORT=9101
PG_PORT=5433
