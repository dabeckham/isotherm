# Secrets & host-specific config
.env
config/stations.yaml
config/sensors.yaml
config/estate.geojson
config/*.geojson
config/*.kml

# Floorplan images & any real placement data are private — never commit them.
config/floorplans/*
!config/floorplans/.gitkeep

# Captured data
data/
*.jsonl

# Cached / self-hosted map tiles (imagery data, incl. drone orthophotos)
tiles/

# Python
__pycache__/
*.pyc
.venv/

# Node / web build (later phases)
node_modules/
web/dist/
web/.vite/

# Editor / OS
.DS_Store
*.swp
*.local
